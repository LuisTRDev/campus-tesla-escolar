# Mismo proyecto de Supabase que Tesla Control Escolar.
# Usa la Publishable/anon key, NUNCA la service_role.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# Dominio interno para las cuentas creadas con DNI (alumno.DNI@dominio).
# Debe ser IGUAL al secreto LOGIN_DOMAIN de la Edge Function campus-accounts.
VITE_LOGIN_DOMAIN=campus.tesla.edu.pe

# Clave PÚBLICA VAPID para notificaciones push (npx web-push generate-vapid-keys).
# La privada va solo como secreto de la Edge Function campus-push.
VITE_VAPID_PUBLIC_KEY=
